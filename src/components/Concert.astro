---
import FormattedDate from './FormattedDate.astro';
import Song from './Song.astro';
import type { Concert } from '../types/concert';

export interface Props {
  concert: {
    id: string;
    data: Concert;
  };
  index: number;
}

const { concert, index } = Astro.props;
---
<>
  <tr class="transition hover:bg-surface-hover">
    <td
      class="border-b border-border bg-neutral-500 px-4 py-2 text-center font-mono text-3xl tracking-tight text-neutral-50">
      {index + 1}
    </td>
    <td class="border-b border-border px-4 py-2 text-text">
      <FormattedDate date={concert.data.date} />
    </td>
    <td class="border-b border-border px-4 py-2 text-text">
      <span>{concert.data.venue.name}</span>
      <br />
      <span class="text-sm text-text-muted italic">
        {concert.data.venue.city}, {concert.data.venue.country}
      </span>
    </td>
    <td class="border-b border-border px-4 py-2">
      <button
        type="button"
        class="rounded bg-surface-muted px-3 py-1 text-sm text-text transition hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-600 dark:hover:bg-neutral-600 dark:focus-visible:outline-neutral-400"
        data-setlist-toggle={index}
        aria-controls={`setlist-${index}`}
        aria-expanded="false">
        View setlist
      </button>
    </td>
  </tr>
  <tr>
    <td colspan="4" class="bg-surface-muted p-0">
      <div
        id={`setlist-${index}`}
        aria-label="Concert setlist"
        class="overflow-hidden transition-all duration-800 ease-in-out"
        style="max-height: 0;">
        <ul class="w-full px-8 py-4 text-base text-text-muted" aria-label="Setlist songs">
          {
            concert.data.songs &&
              concert.data.songs.map((song) => (
                <Song order={song.order} title={song.title} />
              ))
          }
        </ul>
      </div>
    </td>
  </tr>
</>