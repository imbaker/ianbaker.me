---
import FormattedDate from './FormattedDate.astro';
import Song from './Song.astro';
import type { Concert } from '../types/concert';

export interface Props {
  concert: {
    id: string;
    data: Concert;
  };
  index: number;
}

const { concert, index } = Astro.props;
---
<>
<tr class="transition hover:bg-gray-50 dark:hover:bg-gray-800">
  <td
    class="border-b border-gray-200 bg-gray-500 px-4 py-2 text-center font-mono text-3xl tracking-tight text-gray-50 dark:border-gray-700 dark:bg-gray-700">
    {index + 1}
  </td>
  <td class="border-b border-gray-200 px-4 py-2 text-gray-700 dark:border-gray-700 dark:text-gray-300">
    <FormattedDate date={concert.data.date} />
  </td>
  <td class="border-b border-gray-200 px-4 py-2 text-gray-700 dark:border-gray-700 dark:text-gray-300">
    <span>{concert.data.venue.name}</span>
    <br />
    <span class="text-sm text-gray-500 italic dark:text-gray-400">
      {concert.data.venue.city}, {concert.data.venue.country}
    </span>
  </td>
  <td class="border-b border-gray-200 px-4 py-2 dark:border-gray-700">
    <button
      type="button"
      class="rounded bg-gray-100 px-3 py-1 text-sm text-gray-700 transition hover:bg-gray-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 dark:focus-visible:outline-gray-400"
      data-setlist-toggle={index}
      aria-controls={`setlist-${index}`}
      aria-expanded="false">
      View setlist
    </button>
  </td>
</tr>
<tr>
  <td colspan="4" class="bg-gray-50 p-0 dark:bg-gray-800">
    <div
      id={`setlist-${index}`}
      aria-label="Concert setlist"
      class="overflow-hidden transition-all duration-800 ease-in-out"
      style="max-height: 0;">
      <ul class="w-full px-8 py-4 text-base text-gray-600 dark:text-gray-300" aria-label="Setlist songs">
          {
            concert.data.songs &&
              concert.data.songs.map((song) => (
                <Song order={song.order} title={song.title} />
              ))
          }
        </ul>
      </div>
    </td>
  </tr>
</>