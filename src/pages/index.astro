---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Concert from '../components/Concert.astro';

const concerts = await getCollection('concerts');
concerts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Layout>
  <div>
    <table class="w-full table-auto border border-gray-200 bg-neutral-50 dark:border-gray-700 dark:bg-gray-900" aria-label="Concert history with setlists">
      <thead>
        <tr class="bg-gray-50 dark:bg-gray-800">
          <th class="border-gray-200 px-4 py-2 text-center font-bold text-gray-700 dark:border-gray-700 dark:text-gray-200"
            >#</th
          >
          <th class="border-gray-200 px-4 py-2 text-left font-bold text-gray-700 dark:border-gray-700 dark:text-gray-200"
            >Date</th
          >
          <th class="border-gray-200 px-4 py-2 text-left font-bold text-gray-700 dark:border-gray-700 dark:text-gray-200"
            >Venue</th
          >
          <th class="border-gray-200 px-4 py-2 text-center font-bold text-gray-700 dark:border-gray-700 dark:text-gray-200"
            ></th
          >
        </tr>
      </thead>
      <tbody>
        {
          concerts.map((concert, index) => (
            <Concert concert={concert} index={index} />
          ))
        }
      </tbody>
    </table>
  </div>

  <script>
    import { initSetlistToggles } from '../scripts/setlistToggle';
    initSetlistToggles();
  </script>
</Layout>

